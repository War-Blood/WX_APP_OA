{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @riconext/hermes-repo capture"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx @riconext/hermes-repo inject"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codebuddy-chat-web@cb_teams_marketplace": true,
    "agent-sdk-dev@cb_teams_marketplace": true
  }
}
