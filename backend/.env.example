# ==========================================
# 智慧办公助手 — 后端环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ==========================================

# ------ 服务配置 ------
NODE_ENV=development
PORT=3000

# ------ OA 数据库（wx_app_oa） ------
OA_DB_HOST=127.0.0.1
OA_DB_PORT=3306
OA_DB_USER=your_db_user
OA_DB_PASSWORD=your_db_password
OA_DB_NAME=wx_app_oa
OA_DB_POOL_MIN=2
OA_DB_POOL_MAX=10

# ------ 旧版数据库（daily_report，可选） ------
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=3306
OLD_DB_USER=your_db_user
OLD_DB_PASSWORD=your_db_password
OLD_DB_NAME=daily_report
OLD_DB_POOL_MIN=1
OLD_DB_POOL_MAX=5

# ------ Redis 缓存 ------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=oa:

# ------ JWT 认证 ------
JWT_SECRET=your_jwt_secret_base64_32bytes
JWT_EXPIRES_IN=7d

# ------ 微信小程序 ------
WX_APPID=wx56609483f0ee55b6
WX_SECRET=your_wechat_app_secret

# ------ 微信模板消息（在微信公众平台申请后填入） ------
WECHAT_TEMPLATE_ID_REMINDER=your_template_id_here

# ------ 日志 ------
LOG_LEVEL=debug
LOG_DIR=./logs

# ------ Swagger ------
SWAGGER_ENABLED=true

# ------ WPS 对接（可选） ------
WPS_API_KEY=your_wps_api_key

# ------ 企业微信（可选） ------
QYWX_CORPID=
QYWX_SECRET=
